# artisan-pisciniste.fr — Hostinger (LiteSpeed / Apache)
Options -MultiViews -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. HTTPS + domaine sans www (une seule adresse officielle).
#    Limité au vrai domaine : le site reste testable sur l'adresse temporaire Hostinger.
RewriteCond %{HTTP_HOST} ^www\.artisan-pisciniste\.fr$ [NC]
RewriteRule ^ https://artisan-pisciniste.fr%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^artisan-pisciniste\.fr$ [NC]
RewriteRule ^ https://artisan-pisciniste.fr%{REQUEST_URI} [L,R=301]

# 2. /page.html -> /page  (les adresses publiques n'ont jamais d'extension)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [L,R=301]
RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301,NE]
RewriteRule ^index$ / [L,R=301]

# 3. Barre finale superflue -> sans barre
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [L,R=301]

# 4. Anciennes adresses du constructeur de site -> nouvelles pages
RewriteRule ^blog/?$ /blog-list [L,R=301]

# 5. /page servie depuis page.html (mêmes adresses que l'ancien site)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)$ /$1.html [L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
<FilesMatch "\.(webp|jpg|png|woff2|js|css)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml text/xml
</IfModule>

<FilesMatch "^(contact-config|mail-template|crm-db)\.php$">
Require all denied
</FilesMatch>

# Fichiers du dépôt Git à ne pas servir
<FilesMatch "^(README\.md|\.gitignore)$">
Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
RedirectMatch 404 ^/crm-data(/|$)
